{
  "name": "@ken/expo",
  "private": true,
  "main": "index.ts",
  "expo": {
    "autolinking": {
      "//": "ClerkExpo's native module (prebuilt AuthView/UserButton views) requires iOS 17, above this app's Expo-default 16.4 target. The JS SDK detects the missing module and runs pure-JS — everything this app uses (ClerkProvider, hooks, tokenCache) works without it. Remove this block if the deployment target is ever raised to 17.",
      "exclude": [
        "@clerk/expo"
      ]
    }
  },
  "scripts": {
    "clean": "git clean -xdf .cache .expo .turbo android ios node_modules",
    "dev": "pnpm with-env expo start",
    "dev:android": "pnpm with-env expo start --android",
    "dev:ios": "pnpm with-env expo start --ios",
    "android": "pnpm with-env expo run:android",
    "ios": "pnpm with-env expo run:ios",
    "prebuild": "pnpm with-env expo prebuild",
    "with-env": "dotenv -e ../../.env --",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/expo": "catalog:",
    "@ken/analytics": "workspace:*",
    "@ken/backend": "workspace:*",
    "@ken/tokens": "workspace:*",
    "@ken/ui-mobile": "workspace:*",
    "@sentry/react-native": "^7.11.0",
    "convex": "catalog:",
    "expo": "~57.0.9",
    "expo-auth-session": "~57.0.5",
    "expo-constants": "~57.0.8",
    "expo-dev-client": "~57.0.10",
    "expo-device": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-notifications": "~57.0.8",
    "expo-router": "~57.0.9",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.11",
    "expo-web-browser": "~57.0.2",
    "phosphor-react-native": "catalog:native",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "react-native": "catalog:native",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-mmkv": "catalog:native",
    "react-native-reanimated": "catalog:native",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "catalog:native",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@ken/tsconfig": "workspace:*",
    "@types/react": "catalog:react19",
    "dotenv-cli": "^10.0.0",
    "typescript": "catalog:"
  }
}
