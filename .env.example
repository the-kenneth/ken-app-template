# =============================================================================
# .env is gitignored. Copy this file to .env and fill in the values:
#   cp .env.example .env
# Keep this file up to date when you add new variables.
#
# NOTE: two more variables live in the CONVEX DASHBOARD, not in this file
# (Settings → Environment Variables, per deployment):
#   CLERK_JWT_ISSUER_DOMAIN  — your Clerk Frontend API URL (required)
#   CLERK_WEBHOOK_SECRET     — Clerk webhook signing secret (production checklist)
# =============================================================================

# -----------------------------------------------------------------------------
# Convex — created automatically by `pnpm dev:backend` on first run
# (it writes CONVEX_DEPLOYMENT here and prints the URL).
# Dashboard: https://dashboard.convex.dev
# -----------------------------------------------------------------------------
CONVEX_DEPLOYMENT=""
NEXT_PUBLIC_CONVEX_URL="https://YOUR-DEPLOYMENT.convex.cloud"
EXPO_PUBLIC_CONVEX_URL="https://YOUR-DEPLOYMENT.convex.cloud"

# -----------------------------------------------------------------------------
# Clerk — from https://dashboard.clerk.com → your app → API keys
# The publishable key is safe to expose; the secret key is server-only.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# -----------------------------------------------------------------------------
# Sentry (OPTIONAL) — crash reporting is a no-op while these are empty.
# Create one Sentry project per platform and paste the DSNs to enable.
# https://sentry.io → Project → Settings → Client Keys (DSN)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=""
EXPO_PUBLIC_SENTRY_DSN=""
