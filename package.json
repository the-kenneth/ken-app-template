{
  "name": "ken-app-template",
  "private": true,
  "engines": {
    "node": "^24.15.0",
    "pnpm": "^10.19.0"
  },
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "build": "turbo run build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "dev": "turbo watch dev --continue",
    "dev:next": "turbo watch dev -F @ken/nextjs",
    "dev:backend": "turbo watch dev -F @ken/backend",
    "android": "pnpm -F @ken/expo android",
    "ios": "pnpm -F @ken/expo ios",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "oxlint --type-aware && pnpm lint:i18n",
    "lint:fix": "oxlint --type-aware --fix",
    "lint:i18n": "node scripts/check-i18n.mjs",
    "lint:ws": "sherif",
    "test": "turbo run test",
    "tokens:build": "turbo run tokens:build",
    "typecheck": "turbo run typecheck",
    "ui-add": "turbo run ui-add",
    "init:template": "node scripts/init-template.mjs"
  },
  "devDependencies": {
    "@turbo/gen": "^2.10.4",
    "dotenv-cli": "^10.0.0",
    "eslint-plugin-turbo": "^2.10.4",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "oxlint-tsgolint": "^0.24.0",
    "sherif": "^1.13.0",
    "turbo": "^2.10.4",
    "typescript": "catalog:"
  }
}
